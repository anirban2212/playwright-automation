{
    "default":{
        "formatOptions": {
            "snippetInterface": "async-await"
        },
        "publishQuiet": true,
        "paths": ["tests/feature/**/*.feature"],
        "require": [
             "tests/steps/**/*.ts",
            "src/hooks/hooks.ts"
           
        ],
        "requireModule": [
            "ts-node/register"
        ],
        "dryRun": false,

    "format":[
        "html:test-reports/cucumber-report.html",
        "json:test-reports/cucumber-report.json"
    ]
        
        
    }
}